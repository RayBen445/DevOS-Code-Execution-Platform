rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {uid}
    // Fields:
    //   - uid: string (required)
    //   - displayName: string (optional)
    //   - email: string (required)
    //   - photoURL: string (optional)
    //
    // Collection: projects
    // Document ID: {projectId}
    // Fields:
    //   - id: string (required)
    //   - name: string (required, min 1, max 100)
    //   - ownerId: string (required)
    //   - createdAt: timestamp (required)
    //   - updatedAt: timestamp (required)
    //   - collaborators: list (optional, max 10)
    //
    // Collection: projects/{projectId}/files
    // Document ID: {fileId}
    // Fields:
    //   - id: string (required)
    //   - projectId: string (required)
    //   - name: string (required, min 1, max 100)
    //   - path: string (required)
    //   - content: string (required, max 1MB)
    //   - language: string (required)
    //   - updatedAt: timestamp (required)
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isProjectCollaborator(projectData) {
      return isAuthenticated() && projectData != null && (
        projectData.get('ownerId', '') == request.auth.uid || 
        (projectData.get('collaborators', []) is list && request.auth.uid in projectData.get('collaborators', []))
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid is string && data.uid == request.auth.uid &&
             data.email is string && data.email.size() > 0;
    }

    function isValidProject(data) {
      let requiredFields = ['name', 'ownerId', 'createdAt', 'updatedAt', 'isPublic', 'isTemplate', 'forksCount', 'collaborators'];
      return data.keys().hasAll(requiredFields) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
             data.ownerId == request.auth.uid &&
             data.isPublic is bool &&
             data.isTemplate is bool &&
             data.forksCount is int &&
             (!('parentProjectId' in data) || data.parentProjectId is string) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidFile(data) {
      return data.keys().hasAll(['projectId', 'name', 'path', 'content', 'language', 'updatedAt']) &&
             data.projectId is string &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.path is string &&
             data.content is string && data.content.size() <= 1048576 &&
             data.language is string &&
             data.updatedAt is timestamp;
    }

    function isValidCommit(data) {
      return data.keys().hasAll(['projectId', 'message', 'authorId', 'timestamp', 'filesSnapshot']) &&
             data.projectId is string &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 500 &&
             data.authorId == request.auth.uid &&
             data.timestamp is timestamp &&
             data.filesSnapshot is list;
    }

    function isValidPullRequest(data) {
      return data.keys().hasAll(['projectId', 'title', 'description', 'authorId', 'authorName', 'status', 'timestamp', 'headCommitId']) &&
             data.projectId is string &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 2000 &&
             data.authorId == request.auth.uid &&
             data.status in ['open', 'merged', 'closed'] &&
             data.timestamp is timestamp &&
             data.headCommitId is string;
    }

    function isValidUserSettings(data) {
      let allowedFields = ['githubToken', 'vercelToken', 'username', 'displayName', 'bio', 'avatarUrl', 'updatedAt', 'githubInstallationId'];
      return data.keys().hasOnly(allowedFields) &&
             (!('githubToken' in data) || data.githubToken is string) &&
             (!('vercelToken' in data) || data.vercelToken is string) &&
             (!('username' in data) || (data.username is string && data.username.size() <= 50)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 500)) &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 1000)) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // Rules
    match /users/{uid} {
      // Public profile - only allow read if authenticated
      // Note: In a real app, we'd ensure this document contains no PII
      allow read: if isAuthenticated();
      allow create, update: if isOwner(uid) && isValidUser(request.resource.data);
    }

    match /user_settings/{uid} {
      // Private settings - only owner can read/write
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isValidUserSettings(request.resource.data);
    }

    match /projects/{projectId} {
      allow read: if isProjectCollaborator(resource.data) || resource.data.isPublic == true;
      allow create: if isAuthenticated() && isValidProject(request.resource.data);
      allow update: if isProjectCollaborator(resource.data) && isValidProject(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;

      match /files/{fileId} {
        allow read: if isProjectCollaborator(get(/databases/$(database)/documents/projects/$(projectId)).data) || get(/databases/$(database)/documents/projects/$(projectId)).data.isPublic == true;
        allow create, update: if isProjectCollaborator(get(/databases/$(database)/documents/projects/$(projectId)).data) && isValidFile(request.resource.data);
        allow delete: if isProjectCollaborator(get(/databases/$(database)/documents/projects/$(projectId)).data);
      }

      match /commits/{commitId} {
        allow read: if isProjectCollaborator(get(/databases/$(database)/documents/projects/$(projectId)).data) || get(/databases/$(database)/documents/projects/$(projectId)).data.isPublic == true;
        allow create: if isProjectCollaborator(get(/databases/$(database)/documents/projects/$(projectId)).data) && isValidCommit(request.resource.data);
      }

      match /pullRequests/{prId} {
        allow read: if isProjectCollaborator(get(/databases/$(database)/documents/projects/$(projectId)).data) || get(/databases/$(database)/documents/projects/$(projectId)).data.isPublic == true;
        allow create: if isProjectCollaborator(get(/databases/$(database)/documents/projects/$(projectId)).data) && isValidPullRequest(request.resource.data);
        allow update: if isProjectCollaborator(get(/databases/$(database)/documents/projects/$(projectId)).data) && isValidPullRequest(request.resource.data);
      }
    }
  }
}
