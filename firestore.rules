rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {uid}
    // Fields:
    //   - uid: string (required)
    //   - displayName: string (optional)
    //   - email: string (required)
    //   - photoURL: string (optional)
    //
    // Collection: projects
    // Document ID: {projectId}
    // Fields:
    //   - id: string (required)
    //   - name: string (required, min 1, max 100)
    //   - ownerId: string (required)
    //   - createdAt: timestamp (required)
    //   - updatedAt: timestamp (required)
    //   - collaborators: list (optional, max 10)
    //
    // Collection: projects/{projectId}/files
    // Document ID: {fileId}
    // Fields:
    //   - id: string (required)
    //   - projectId: string (required)
    //   - name: string (required, min 1, max 100)
    //   - path: string (required)
    //   - content: string (required, max 1MB)
    //   - language: string (required)
    //   - updatedAt: timestamp (required)
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email == "oladoyeheritage445@gmail.com" && request.auth.token.get('email_verified', false) == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin')
      );
    }

    function isProjectCollaborator(projectData) {
      return isAuthenticated() && projectData != null && (
        projectData.get('ownerId', '') == request.auth.uid || 
        (projectData.get('collaborators', []) is list && request.auth.uid in projectData.get('collaborators', []))
      );
    }

    function getProjectData(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data;
    }

    function canReadProject(projectId, projectData) {
      return projectData.get('isPublic', false) == true || 
             projectData.get('deployed', false) == true ||
             (projectData.get('isSystem', false) == true && projectData.get('systemType', '') == 'portfolio') || (
        isAuthenticated() && (
          isAdmin() ||
          isProjectCollaborator(projectData) ||
          // Org project: any member of the owning org can read
          (projectData.get('ownerType', '') == 'organization' &&
           projectData.get('ownerOrgId', '') != '' &&
           exists(/databases/$(database)/documents/organizations/$(projectData.get('ownerOrgId', ''))/members/$(request.auth.uid)))
        )
      );
    }

    function canWriteProject(projectId, projectData) {
      return isAuthenticated() && (
        isAdmin() ||
        isProjectCollaborator(projectData) ||
        // Org project: any member of the owning org can write
        (projectData.get('ownerType', '') == 'organization' &&
         projectData.get('ownerOrgId', '') != '' &&
         exists(/databases/$(database)/documents/organizations/$(projectData.get('ownerOrgId', ''))/members/$(request.auth.uid)))
      );
    }

    function isValidUser(data) {
      let allowedFields = ['uid', 'email', 'username', 'displayName', 'fullName', 'bio', 'avatarUrl', 'avatar', 'updatedAt', 'role', 'status', 'birthday', 'links', 'skills', 'dailyStreak', 'monthlyStreak', 'lastActiveDate', 'lastActiveMonth', 'activeDaysThisMonth', 'companyName', 'verified', 'logo', 'description'];
      return data.keys().hasOnly(allowedFields) &&
             data.uid is string && data.uid == request.auth.uid &&
             data.email is string &&
             (!('username' in data) || (data.username is string && data.username.size() <= 50)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('fullName' in data) || (data.fullName is string && data.fullName.size() <= 100)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 500)) &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 1000)) &&
             (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 1000)) &&
             (!('logo' in data) || (data.logo is string && data.logo.size() <= 1000)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
             (!('birthday' in data) || data.birthday is string) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp) &&
             (!('role' in data) || data.role in ['user', 'admin', 'company']) &&
             // Owners may only self-deactivate or restore to active; admin sets ban/suspend via a separate rule
             (!('status' in data) || data.status in ['active', 'deactivated']) &&
             (!('links' in data) || data.links is map) &&
             (!('skills' in data) || data.skills is list);
    }

    function isValidProject(data) {
      let requiredFields = ['name', 'ownerId', 'createdAt', 'updatedAt', 'isPublic', 'isTemplate', 'forksCount', 'collaborators'];
      let allowedFields = requiredFields.concat(['appId', 'description', 'title', 'ownerUsername', 'projectSlug', 'parentProjectId', 'parentTemplateId', 'forkedFrom', 'forkedFromOwner', 'forkedFromTitle', 'githubRepo', 'githubUrl', 'deployUrl', 'liveUrl', 'isSystem', 'systemType', 'isEditable', 'isDeletable', 'views', 'draft', 'published', 'deployStatus', 'lastDeployedAt', 'deployError', 'entryFile', 'savedAt', 'env', 'plugins', 'ownerType', 'ownerOrgId', 'activeDeploymentId', 'isOfficial', 'group', 'tags', 'ownerOrgSlug', 'ownerOrgName', 'slug', 'deployed', 'language', 'framework', 'thumbnailUrl']);
      return data.keys().hasAll(requiredFields) &&
             data.keys().hasOnly(allowedFields) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             (!('title' in data) || (data.title is string && data.title.size() <= 100)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
             data.ownerId is string &&
             (!('ownerUsername' in data) || (data.ownerUsername is string && data.ownerUsername.size() <= 50)) &&
             (!('projectSlug' in data) || (data.projectSlug is string && data.projectSlug.size() <= 100)) &&
             (!('entryFile' in data) || (data.entryFile is string && data.entryFile.size() <= 500)) &&
             (!('savedAt' in data) || data.savedAt is timestamp) &&
             (!('env' in data) || data.env is map) &&
             (!('plugins' in data) || data.plugins is map) &&
             data.isPublic is bool &&
             data.isTemplate is bool &&
             data.forksCount is int &&
             (!('views' in data) || data.views is int) &&
             (!('parentProjectId' in data) || data.parentProjectId is string) &&
             (!('parentTemplateId' in data) || data.parentTemplateId is string) &&
             (!('forkedFrom' in data) || data.forkedFrom is string) &&
             (!('forkedFromOwner' in data) || data.forkedFromOwner is string) &&
             (!('forkedFromTitle' in data) || (data.forkedFromTitle is string && data.forkedFromTitle.size() <= 100)) &&
             (!('language' in data) || (data.language is string && data.language.size() <= 50)) &&
             (!('framework' in data) || (data.framework is string && data.framework.size() <= 50)) &&
             (!('thumbnailUrl' in data) || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 1000)) &&
             (!('deployUrl' in data) || (data.deployUrl is string && data.deployUrl.size() <= 1000)) &&
             (!('liveUrl' in data) || (data.liveUrl is string && data.liveUrl.size() <= 1000)) &&
             (!('githubRepo' in data) || (data.githubRepo is string && data.githubRepo.size() <= 200)) &&
             (!('githubUrl' in data) || (data.githubUrl is string && data.githubUrl.size() <= 1000)) &&
             (!('isSystem' in data) || data.isSystem is bool) &&
             (!('systemType' in data) || data.systemType == null || (data.systemType is string && data.systemType in ['portfolio', 'blog', 'docs'])) &&
             (!('isEditable' in data) || data.isEditable is bool) &&
             (!('isDeletable' in data) || data.isDeletable is bool) &&
             (!('draft' in data) || data.draft is map) &&
             (!('published' in data) || data.published is map) &&
             (!('deployStatus' in data) || data.deployStatus in ['idle', 'building', 'success', 'failed']) &&
             (!('lastDeployedAt' in data) || data.lastDeployedAt is timestamp) &&
             (!('deployError' in data) || data.deployError is string) &&
             (!('ownerType' in data) || data.ownerType in ['user', 'organization']) &&
             (!('ownerOrgId' in data) || data.ownerOrgId is string) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp &&
             data.collaborators is list;
    }

    function isValidFile(data) {
      return data.keys().hasAll(['projectId', 'name', 'path', 'content', 'language', 'updatedAt']) &&
             data.projectId is string &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.path is string &&
             data.content is string && data.content.size() <= 1048576 &&
             data.language is string &&
             data.updatedAt is timestamp;
    }

    function isValidCommit(data) {
      return data.keys().hasAll(['projectId', 'message', 'authorId', 'timestamp', 'filesSnapshot']) &&
             data.projectId is string &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 500 &&
             data.authorId is string &&
             data.timestamp is timestamp &&
             data.filesSnapshot is list;
    }

    function isValidPullRequest(data) {
      return data.keys().hasAll(['projectId', 'title', 'description', 'authorId', 'authorName', 'status', 'timestamp', 'headCommitId']) &&
             data.projectId is string &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 2000 &&
             data.authorId is string &&
             data.status in ['open', 'merged', 'closed'] &&
             data.timestamp is timestamp &&
             data.headCommitId is string;
    }

    function isValidUserSettings(data) {
      let allowedFields = ['githubToken', 'vercelToken', 'username', 'displayName', 'fullName', 'bio', 'avatarUrl', 'avatar', 'updatedAt', 'githubInstallationId', 'links', 'preferences', 'notifications', 'skills', 'birthday', 'bottomNavButtons'];
      return data.keys().hasOnly(allowedFields) &&
             (!('githubToken' in data) || data.githubToken is string) &&
             (!('vercelToken' in data) || data.vercelToken is string) &&
             (!('username' in data) || (data.username is string && data.username.size() <= 50)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('fullName' in data) || (data.fullName is string && data.fullName.size() <= 100)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 500)) &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 1000)) &&
             (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 1000)) &&
             (!('birthday' in data) || data.birthday is string) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp) &&
             (!('links' in data) || data.links is map) &&
             (!('skills' in data) || data.skills is list) &&
             (!('preferences' in data) || data.preferences is map) &&
             (!('notifications' in data) || data.notifications is map) &&
             (!('bottomNavButtons' in data) || (data.bottomNavButtons is list && data.bottomNavButtons.size() <= 4));
    }

    // Rules
    match /users/{uid} {
      allow read: if true;
      // Owner can create / update their own profile (isValidUser enforces status only in ['active','deactivated'])
      allow create: if isOwner(uid) && isValidUser(request.resource.data);
      allow update: if (isOwner(uid) && isValidUser(request.resource.data)) ||
                       // Admin can update any field — needed for ban, suspend, reinstate
                       isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /user_settings/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if (isOwner(uid) && isValidUserSettings(request.resource.data)) || isAdmin();
    }

    match /projects/{projectId} {
      allow read: if canReadProject(projectId, resource.data);
      allow create: if isAuthenticated() && isValidProject(request.resource.data) && (
        request.resource.data.ownerId == request.auth.uid ||
        isAdmin() ||
        // Org member creating a project under their organization
        (request.resource.data.get('ownerType', '') == 'organization' &&
         request.resource.data.get('ownerOrgId', '') != '' &&
         exists(/databases/$(database)/documents/organizations/$(request.resource.data.ownerOrgId)/members/$(request.auth.uid)))
      );
      allow update: if isAdmin() || (canWriteProject(projectId, resource.data) && isValidProject(request.resource.data));
      allow delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin()) && resource.data.get('isDeletable', true) == true;

      match /files/{fileId} {
        allow read: if canReadProject(projectId, getProjectData(projectId));
        allow create, update: if canWriteProject(projectId, getProjectData(projectId)) && isValidFile(request.resource.data);
        allow delete: if canWriteProject(projectId, getProjectData(projectId));
      }

      match /commits/{commitId} {
        allow read: if canReadProject(projectId, getProjectData(projectId));
        allow create: if canWriteProject(projectId, getProjectData(projectId)) && isValidCommit(request.resource.data);
      }

      match /pullRequests/{prId} {
        allow read: if canReadProject(projectId, getProjectData(projectId));
        allow create: if canWriteProject(projectId, getProjectData(projectId)) && isValidPullRequest(request.resource.data);
        allow update: if canWriteProject(projectId, getProjectData(projectId)) && isValidPullRequest(request.resource.data);
      }

      match /versions/{versionId} {
        allow read: if canReadProject(projectId, getProjectData(projectId));
        allow create, delete: if canWriteProject(projectId, getProjectData(projectId));
      }

      match /messages/{messageId} {
        allow create: if true;
        allow read, update, delete: if canWriteProject(projectId, getProjectData(projectId));
      }

      // Real-time presence: each user writes only their own doc; all project readers can see who's online
      match /presence/{uid} {
        allow read: if canReadProject(projectId, getProjectData(projectId));
        allow write: if isAuthenticated() && request.auth.uid == uid;
      }

      // Activity stream: project members append events; all project readers can see the stream
      match /activity/{activityId} {
        allow read: if canReadProject(projectId, getProjectData(projectId));
        allow create: if canWriteProject(projectId, getProjectData(projectId));
      }
    }

    match /templates/{templateId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
    }

    match /user_credits/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Owner can create their own credits doc (initialisation on first deploy/load)
      allow create: if isOwner(uid) || isAdmin();
      // Owner can update their own credits (deduct on deploy/sync, reset daily/monthly).
      // Admin can also adjust credits (top-up via dashboard).
      // Any authenticated user may increment daily credits by exactly REFERRER_BONUS (25)
      // to support client-side referral processing where the referred user awards the referrer.
      allow update: if isOwner(uid) || isAdmin() ||
        (
          isAuthenticated() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['daily']) &&
          request.resource.data.daily == resource.data.daily + 25
        );
      allow delete: if isAdmin();

      match /transactions/{txId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) || isAdmin();
        allow update, delete: if isAdmin();
      }
    }

    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('userId', '') == 'all' ||
        isAdmin()
      );
      allow create: if isAdmin() || (
        // Allow authenticated users to create peer notifications
        // (follow, post_like, post_comment, post_repost, community_post)
        // for other users only — never targeting themselves.
        isAuthenticated() &&
        request.resource.data.type in ['follow', 'post_like', 'post_comment', 'post_repost', 'community_post', 'post_mention'] &&
        request.resource.data.get('createdBy', '') == request.auth.uid &&
        request.resource.data.userId != request.auth.uid &&
        request.resource.data.get('isRead', false) == false
      );
      allow update: if isAuthenticated() && (
        // Allow user to mark their targeted notification as read
        resource.data.get('userId', '') == request.auth.uid ||
        // Allow any user to mark broadcast notifications as read (add themselves to readBy)
        resource.data.get('userId', '') == 'all' ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /redeem_codes/{codeId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      // Admins can update any field; authenticated users can only increment usedCount during redemption
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount']) &&
        request.resource.data.usedCount == resource.data.usedCount + 1
      );
    }

    match /users/{uid}/redeemed_codes/{codeId} {
      allow read, write: if isOwner(uid);
    }

    match /feed/{postId} {
      allow read: if resource.data.get('isPublic', false) == true || isAuthenticated();
      allow create: if isAuthenticated() && (
        // Posts without a communityId are always allowed for authenticated users
        request.resource.data.get('communityId', '') == '' ||
        // Community posts — must be a community member
        exists(/databases/$(database)/documents/communities/$(request.resource.data.get('communityId', ''))/members/$(request.auth.uid)) ||
        // Org posts — communityId stores the org's id; must be an org member
        exists(/databases/$(database)/documents/organizations/$(request.resource.data.get('communityId', ''))/members/$(request.auth.uid))
      );
      allow update: if isAuthenticated() && (
        // Post owner and admins may update any field
        resource.data.get('userId', '') == request.auth.uid ||
        isAdmin() ||
        // Any authenticated user may update engagement counters / arrays only
        // (likes, likedBy, commentsCount, repostCount, viewsCount).
        // Additionally, when likedBy is changed the requester may only add or
        // remove their own UID, preventing arbitrary manipulation of the array.
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likes', 'likedBy', 'commentsCount', 'repostCount', 'viewsCount'])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['likedBy'])
            || (
              request.resource.data.get('likedBy', []).toSet()
                .difference(resource.data.get('likedBy', []).toSet())
                .hasOnly([request.auth.uid])
              && resource.data.get('likedBy', []).toSet()
                .difference(request.resource.data.get('likedBy', []).toSet())
                .hasOnly([request.auth.uid])
            )
          )
        )
      );
      allow delete: if isAuthenticated() && (
        resource.data.get('userId', '') == request.auth.uid ||
        isAdmin()
      );
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    match /system_config/{configId} {
      // Maintenance doc must be readable by unauthenticated users so the app
      // can show the maintenance screen before login.
      // Site doc is also public (footer/contact/branding + allowVoiceCalls toggle).
      allow read: if configId in ["maintenance", "site"] || isAuthenticated();
      allow write: if isAdmin();
    }

    match /follows/{followId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.followerId == request.auth.uid &&
        request.resource.data.followingId != request.auth.uid &&
        request.resource.data.followerId is string &&
        request.resource.data.followingId is string &&
        request.resource.data.createdAt is timestamp;
      allow delete: if isAuthenticated() &&
        resource.data.followerId == request.auth.uid;
    }

    // Referral codes — public read so the service can look up a code during sign-up
    match /referral_codes/{code} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Referral events — creator or admin can read; only authenticated users can create
    match /referrals/{docId} {
      allow read: if isAuthenticated() && (
        resource.data.referrerId == request.auth.uid ||
        resource.data.referredId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.referredId == request.auth.uid &&
        request.resource.data.referralCode is string &&
        request.resource.data.referrerId is string &&
        request.resource.data.createdAt is timestamp;
      allow update, delete: if isAdmin();
    }

    // Reserved usernames — public read for sign-up validation; admin write only
    match /reservedUsernames/{username} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Feedback submissions — anyone (including guests) can create; only admins can read/manage
    match /feedback/{docId} {
      allow create: if
        request.resource.data.type in ['bug', 'feature', 'feedback'] &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.message.size() <= 5000;
      allow read, update, delete: if isAdmin();
    }

    // Test collection — used by firebase.ts connection probe (test/connection)
    match /test/{docId} {
      allow read: if true;
    }

    // ── Communities ────────────────────────────────────────────────────────────
    match /communities/{communityId} {
      allow read: if resource.data.get('isPublic', false) == true || isAuthenticated();
      // Any authenticated user can create a community
      allow create: if isAuthenticated() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 100 &&
        request.resource.data.slug is string &&
        request.resource.data.slug.size() > 0 &&
        request.resource.data.description is string;
      // Community admins / platform admins can update metadata.
      // Any authenticated user may increment/decrement memberCount only
      // (triggered by join/leave — no other fields change).
      allow update: if isAdmin() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)).data.role == 'admin'
      ) || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']) &&
        request.resource.data.memberCount is int
      );
      allow delete: if isAdmin();

      // Member subcollection
      match /members/{userId} {
        // Members can read the member list
        allow read: if isAuthenticated();
        // A user can join (create their own member doc) or an admin/moderator can add
        allow create: if isAuthenticated() && (
          request.auth.uid == userId ||
          isAdmin()
        );
        // Role updates by community admin/moderator
        allow update: if isAdmin() || (
          isAuthenticated() &&
          exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)).data.role in ['admin', 'moderator']
        );
        // User can leave (delete their own), or admin/moderator can remove
        allow delete: if isAuthenticated() && (
          request.auth.uid == userId ||
          isAdmin() ||
          (
            exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)).data.role in ['admin', 'moderator']
          )
        );
      }

      match /chat/{messageId} {
        // Any member can read; only members can create their own messages; owner or moderator can delete
        allow read: if isAuthenticated() &&
          exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid));
        allow create: if isAuthenticated() &&
          exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 2000;
        allow delete: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid)).data.role in ['admin', 'moderator'] ||
          isAdmin()
        );
      }
    }

    // ── Account deletion requests ──────────────────────────────────────────────
    match /deletion_requests/{docId} {
      // Owner can create their own deletion request; admin can read/delete
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /username_change_requests/{reqId} {
      // Owner can submit and read their own request; admin has full access
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedUsername is string
        && request.resource.data.requestedUsername.size() >= 3
        && request.resource.data.requestedUsername.size() <= 20;
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ── Polls ──────────────────────────────────────────────────────────────────
    match /polls/{pollId} {
      // Any authenticated user (or public) can read polls
      allow read: if true;
      // Only admins may create or delete polls
      allow create, delete: if isAdmin();
      // Admins may update any field; authenticated users may update only the
      // `options` and `totalVotes` counters as part of the vote transaction.
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['options', 'totalVotes']) &&
        request.resource.data.totalVotes is int &&
        request.resource.data.totalVotes == resource.data.totalVotes + 1
      );

      // Votes subcollection — document ID is the voter's uid
      match /votes/{userId} {
        // Poll voters can read their own vote; admins can read all
        allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
        // Authenticated users can cast their first vote (create) on any poll.
        allow create: if isAuthenticated() && request.auth.uid == userId;
        // Allow overwriting a previous vote when the poll permits multiple votes
        // (allowMultipleVotes == true). The voter may only update their own doc.
        allow update: if isAuthenticated() && request.auth.uid == userId;
        allow delete: if isAdmin();
      }
    }

    // ── Organizations ──────────────────────────────────────────────────────────
    // ── Organizations ──────────────────────────────────────────────────────────
    match /organizations/{orgId} {
      // Public orgs are readable by everyone; private orgs require membership
      allow read: if resource.data.get('isPublic', false) == true || isAuthenticated();

      // Any authenticated user can create an organization
      allow create: if isAuthenticated() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 100 &&
        request.resource.data.slug is string &&
        request.resource.data.slug.size() > 0 &&
        request.resource.data.description is string;

      // Org owners/admins or platform admins can update metadata.
      // Any authenticated member may update memberCount only (join/leave).
      allow update: if isAdmin() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role in ['admin', 'owner']
      ) || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']) &&
        request.resource.data.memberCount is int
      );

      allow delete: if isAdmin() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role in ['admin', 'owner']
      );

      // Member subcollection — document ID is the user's uid
      match /members/{userId} {
        allow read: if isAuthenticated();
        // A user can join (create their own member doc) or an org/platform admin can add
        allow create: if isAuthenticated() && (
          request.auth.uid == userId ||
          isAdmin()
        );
        // Role updates by org owner/admin or platform admin
        allow update: if isAdmin() || (
          isAuthenticated() &&
          exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role in ['admin', 'owner']
        );
        // User can leave (delete own) or org owner/admin can remove
        allow delete: if isAuthenticated() && (
          request.auth.uid == userId ||
          isAdmin() ||
          (
            exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role in ['admin', 'owner']
          )
        );
      }

      // Chat subcollection — org members only
      match /chat/{messageId} {
        // Any org member can read messages
        allow read: if isAuthenticated() &&
          exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
        // Org members can send messages as themselves
        allow create: if isAuthenticated() &&
          exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 2000;
        // Message owner, org admin, or platform admin can delete
        allow delete: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          (exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role == 'admin') ||
          isAdmin()
        );
      }

      // Join-request subcollection — keyed by the requesting user's uid
      match /joinRequests/{userId} {
        // Requester sees their own; org admins see all
        allow read: if isAuthenticated() && (
          request.auth.uid == userId ||
          isAdmin() ||
          (exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role == 'admin')
        );
        // Any authenticated user can create their own request
        allow create: if isAuthenticated() && request.auth.uid == userId;
        // Org admins or platform admins can approve/reject (update status)
        allow update: if isAdmin() || (
          isAuthenticated() &&
          exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role == 'admin'
        );
        // Requester can withdraw; org admins can delete
        allow delete: if isAuthenticated() && (
          request.auth.uid == userId ||
          isAdmin() ||
          (exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role == 'admin')
        );
      }
    }

    // ── Events Platform ───────────────────────────────────────────────────────

    // Chapters — public read, authenticated create, admin write
    match /chapters/{chapterId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Event Series — public read, authenticated create, admin write
    match /event_series/{seriesId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Events — public read of approved events, auth create, admin update/delete
    match /events/{eventId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      // Creator can update their own event while it is pending or under review;
      // admin can update any event at any time.
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.createdBy == request.auth.uid &&
        resource.data.status in ['pending', 'under_review']
      );
      allow delete: if isAdmin();
    }

    // Event Registrations — auth users can create their own, admin reads all
    match /event_registrations/{regId} {
      // Admin can read all; authenticated user can read their own
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      // Any user (authenticated or guest) can register (create)
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Speakers — public read, admin write
    match /speakers/{speakerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Event Speakers (join table) — public read, admin write
    match /event_speakers/{linkId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── User activities (heatmap data) ────────────────────────────────────────
    match /user_activities/{actId} {
      // Anyone can read their own activities; public profiles can be read by all
      allow read: if true;
      // Only the owning user (or server via admin SDK) may write
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Audit Logs ────────────────────────────────────────────────────────────
    match /audit_logs/{logId} {
      // Only admins or the owning user may read audit entries
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      // Authenticated users may append their own audit entries (no update/delete)
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Build Jobs ────────────────────────────────────────────────────────────
    match /build_jobs/{jobId} {
      // Owner or admin can read
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      // Owner can create their own jobs
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Server (via Admin SDK) updates status; owner may not directly mutate
      allow update, delete: if isAdmin();
    }

    // ── Build Cache ───────────────────────────────────────────────────────────
    match /build_cache/{hash} {
      // Any authenticated user can read (cache is keyed by content hash — no secrets)
      allow read: if isAuthenticated();
      // Only write via Admin SDK / server; clients use the API
      allow write: if false;
    }

    // ── Deployment Files (diff snapshots) ────────────────────────────────────
    match /deployment_files/{projectId} {
      allow read: if isAuthenticated();
      allow write: if false; // written by server/Admin SDK only
    }

    // ── Deployments ───────────────────────────────────────────────────────────
    match /deployments/{deploymentId} {
      // Public read for public projects; private restricts to owner/admin
      allow read: if true;
      // Owner may create; updates (rollback/promote) only via server or admin
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (
        isAuthenticated() && resource.data.userId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // ── Passkeys (legacy + current server-managed storage) ───────────────────
    // Legacy client-managed path retained for backwards compatibility.
    match /passkeys/{userId}/credentials/{credentialId} {
      allow read, write: if isOwner(userId);
    }

    // Current passkey implementation is API/server-managed (Admin SDK), so
    // direct client reads/writes are denied for both credential and challenge
    // collections to keep challenge material and counters protected.
    match /passkey_credentials/{credentialId} {
      allow read, write: if false;
    }
    match /passkey_challenges/{challengeId} {
      allow read, write: if false;
    }

    // ── Email Jobs ────────────────────────────────────────────────────────────
    // Client-side code enqueues email jobs (e.g. welcome, deploy notifications).
    // The actual sending runs via the server-side email-worker API (Admin SDK,
    // bypasses these rules).  Admins can inspect and manage the queue.
    match /email_jobs/{jobId} {
      // Admins can read, retry, and purge any job.
      allow read, update, delete: if isAdmin();
      // Any authenticated user may create a job for their own account.
      // The userId field is optional on the document; if present it must match
      // the caller's uid so no user can queue jobs on behalf of another.
      allow create: if isAuthenticated() && (
        !('userId' in request.resource.data) ||
        request.resource.data.userId == null ||
        request.resource.data.userId == request.auth.uid
      );
    }

    // ── Voice Rooms — real-time call presence ─────────────────────────────────
    match /voice_rooms/{roomId} {
      allow read: if isAuthenticated();
      // Allow users to create or update the room (to add/remove themselves from participants)
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
      
      // Signals subcollection for WebRTC SDP and ICE candidates
      match /signals/{signalId} {
        allow read, write: if isAuthenticated();
      }
    }

    // ── Learn Lessons — admin-managed content ─────────────────────────────────
    // Public read (so learners don't need to be logged in).
    // Only admins may create, update, or delete lessons.
    match /learn_lessons/{lessonId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Learn Progress — per-user lesson progress ──────────────────────────────
    // Each user stores their own lesson completion state.
    match /learn_progress/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // ── User Notification Settings — per-user email/push opt-ins ──────────────
    // Only the owning user (or admin) may read or change their preferences.
    match /user_notification_settings/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // ── Plugin Data — isolated plugin namespaces ───────────────────────────────
    // All client-side reads/writes are blocked; only Cloud Functions (Admin SDK)
    // interact with this collection so standard client rules are not needed here.
    // We still declare the match to make the intent explicit.
    match /plugin_data/{projectId}/{document=**} {
      allow read, write: if false;
    }
  }
}
