# GitHub App Credentials
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

# Firebase Admin SDK — required for server-side auth & Firestore access
# Generate a service account key in the Firebase Console → Project Settings → Service Accounts
FIREBASE_SERVICE_ACCOUNT_JSON=
# Your Firebase project ID (e.g. my-project-12345)
FIREBASE_PROJECT_ID=

# Gmail SMTP — used by the Admin Dashboard email sender
# Generate an App Password at https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=
# Optional: override the sender address (defaults to coolshotsystemsofficial@gmail.com)
GMAIL_SENDER_ADDRESS=
