# =============================================================================
# DevOS — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# VITE_* variables are exposed to the browser (Vite client-side).
# Variables WITHOUT the VITE_ prefix are server-side only (Cloud Functions, etc.)
# Never commit the actual .env file to version control.
# =============================================================================


# ── GitHub App ────────────────────────────────────────────────────────────────
# Used for GitHub OAuth and repo integration.
# Create at https://github.com/settings/apps
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=


# ── Firebase (client-side — exposed to browser) ───────────────────────────────
# Obtain from Firebase Console → Project Settings → General → Your apps → Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=


# ── Firebase Admin SDK (server-side only) ────────────────────────────────────
# Generate a service account key:
#   Firebase Console → Project Settings → Service Accounts → Generate new private key
# Vercel setup options:
#   Option A (recommended): set FIREBASE_SERVICE_ACCOUNT_JSON to the full JSON object
#   Option B: set FIREBASE_SERVICE_ACCOUNT_BASE64 to base64(service-account.json)
#   Option C: set FIREBASE_PROJECT_ID + FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY
#             (for FIREBASE_PRIVATE_KEY, keep escaped newlines: \\n)
# In Vercel: Project → Settings → Environment Variables → Add each variable for
# Preview/Production, then redeploy.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=


# ── Supabase Storage ──────────────────────────────────────────────────────────
# Used for all image uploads: user avatars, event banners, community images, etc.
# If these are NOT set, DevOS automatically falls back to Firebase Storage.
#
# Obtain from: https://app.supabase.com → Project Settings → API
#
# VITE_SUPABASE_URL      — your project URL (e.g. https://xxxx.supabase.co)
# VITE_SUPABASE_ANON_KEY — public anon key (safe to expose to the browser)
# SUPABASE_SERVICE_ROLE_KEY — SECRET server-side key (NEVER expose to browser)
#                             Used by Cloud Functions for storage cleanup on
#                             account deletion (devos_delete_user_storage).
# VITE_SUPABASE_BUCKET   — storage bucket name (default: devos-media)
#                          Run supabase/storage.sql first to create the bucket.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_BUCKET=devos-media


# ── Email (server-side only) ──────────────────────────────────────────────────
# Gmail SMTP — primary transport for Admin Dashboard email sender.
# Generate an App Password at https://myaccount.google.com/apppasswords
# (Requires 2FA enabled on the Google account)
GMAIL_APP_PASSWORD=
# Optional: override the sender address (defaults to the configured admin email)
GMAIL_SENDER_ADDRESS=

# Resend — optional fallback email transport (used when GMAIL_APP_PASSWORD is unset)
# Obtain an API key at https://resend.com
RESEND_API_KEY=
