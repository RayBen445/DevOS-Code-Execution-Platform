rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Avatar uploads (legacy path): authenticated users can read/write only their own folder
    match /avatars/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size <= 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // User media uploads: authenticated users can read/write only their own folder
    match /users/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size <= 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Event banners: authenticated users can upload; public read
    match /events/{eventId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size <= 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Community images: authenticated users can upload; public read
    match /communities/{communityId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size <= 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Organisation images: authenticated users can upload; public read
    match /orgs/{orgId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size <= 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Template preview images: authenticated users can upload; public read
    match /templates/{templateId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size <= 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Project file images (uploaded via IDE/Sidebar): authenticated users can upload; public read
    match /projects/{projectId}/files/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size <= 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
