{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A coding project containing multiple files.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "collaborators": {
          "type": "array",
          "items": { "type": "string" }
        },
        "isPublic": { "type": "boolean" },
        "isTemplate": { "type": "boolean" },
        "forksCount": { "type": "integer" },
        "parentProjectId": { "type": "string" }
      },
      "required": ["name", "ownerId", "createdAt", "isPublic", "isTemplate", "forksCount"]
    },
    "File": {
      "title": "File",
      "description": "A file within a project.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "name": { "type": "string" },
        "path": { "type": "string" },
        "content": { "type": "string" },
        "language": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "name", "path", "content"]
    },
    "User": {
      "title": "User",
      "description": "A public user profile.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "Private user settings and tokens.",
      "type": "object",
      "properties": {
        "githubToken": { "type": "string" },
        "vercelToken": { "type": "string" },
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "bio": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "githubInstallationId": { "type": "string" }
      }
    },
    "Commit": {
      "title": "Commit",
      "description": "A snapshot of the project at a point in time.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "message": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "filesSnapshot": { 
          "type": "array",
          "items": { "type": "object" }
        }
      },
      "required": ["projectId", "message", "authorId", "timestamp", "filesSnapshot"]
    },
    "PullRequest": {
      "title": "PullRequest",
      "description": "A request to merge changes.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "merged", "closed"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "headCommitId": { "type": "string" }
      },
      "required": ["projectId", "title", "authorId", "status", "timestamp", "headCommitId"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Collection of projects."
    },
    "/projects/{projectId}/files/{fileId}": {
      "schema": "File",
      "description": "Files belonging to a project."
    },
    "/projects/{projectId}/commits/{commitId}": {
      "schema": "Commit",
      "description": "Version history for a project."
    },
    "/projects/{projectId}/pullRequests/{prId}": {
      "schema": "PullRequest",
      "description": "Pull requests for a project."
    },
    "/users/{uid}": {
      "schema": "User",
      "description": "User profiles."
    },
    "/user_settings/{uid}": {
      "schema": "UserSettings",
      "description": "Private user settings."
    }
  }
}
